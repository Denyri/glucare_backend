<mxfile host="app.diagrams.net">
  <diagram id="gambaran-umum" name="Gambaran Umum Sistem">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== BARIS 1: Pengguna & Aplikasi ===== -->
        <mxCell id="user" value="&lt;b&gt;Pengguna&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="25" width="30" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;Aplikasi GluCare&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="30" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e_user_app" value="Login, skrining,&lt;br&gt;misi harian" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="55" as="sourcePoint"/>
            <mxPoint x="330" y="55" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== BARIS 2: Data Pengguna, Engine, AI Service ===== -->
        <mxCell id="datauser" value="&lt;b&gt;Data Pengguna&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Profil &amp;amp; data tubuh&lt;br&gt;• Hasil pemeriksaan klinis&lt;br&gt;• Jawaban kuesioner&lt;br&gt;• Catatan misi harian&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="190" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="engine" value="&lt;b&gt;Engine GluCare&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Backend Node.js + Express.js&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="180" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ai" value="&lt;b&gt;AI Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Python + FastAPI&lt;/font&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Model klinis&lt;br&gt;• Model kuesioner&lt;br&gt;• Rekomendasi program&lt;br&gt;• Evaluasi hari ke-30 &amp;amp; ke-90&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;arcSize=6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="150" width="200" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="e_app_engine" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="app" target="engine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_data_engine" style="endArrow=classic;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="230" y="220" as="sourcePoint"/>
            <mxPoint x="330" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_engine_ai" value="Data skrining &amp;amp; catatan harian" style="endArrow=classic;html=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="205" as="sourcePoint"/>
            <mxPoint x="740" y="205" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_ai_engine" value="Hasil prediksi &amp;amp; rekomendasi" style="endArrow=classic;html=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=top;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="240" as="sourcePoint"/>
            <mxPoint x="530" y="240" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== BARIS 3: Proses & Data Hasil ===== -->
        <mxCell id="klinis" value="&lt;b&gt;Skrining Klinis&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Validasi data klinis&lt;br&gt;• Kirim ke AI Service&lt;br&gt;• Simpan hasil&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="350" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="kues" value="&lt;b&gt;Skrining Kuesioner&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Validasi jawaban&lt;br&gt;• Kirim ke AI Service&lt;br&gt;• Simpan hasil&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="350" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="program" value="&lt;b&gt;Program 90 Hari&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Target awal&lt;br&gt;• Misi harian &amp;amp; GDP&lt;br&gt;• Evaluasi berkala&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="350" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="hasil" value="&lt;b&gt;Data Hasil&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Tingkat risiko &amp;amp; probabilitas&lt;br&gt;• Faktor risiko &amp;amp; saran&lt;br&gt;• Progres &amp;amp; pencapaian&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;arcSize=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="350" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Engine ke tiga proses (cabang) -->
        <mxCell id="e_eng_kl" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="engine" target="klinis">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="430" y="310"/><mxPoint x="235" y="310"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_eng_ku" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="engine" target="kues">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_eng_pr" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="engine" target="program">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="430" y="310"/><mxPoint x="625" y="310"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_pr_hasil" style="endArrow=classic;html=1;" edge="1" parent="1" source="program" target="hasil">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== BARIS 4: Database ===== -->
        <mxCell id="dbbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="150" y="520" width="560" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="dbicon" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MySQL&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="535" width="90" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="dblist1" value="&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Data pengguna&lt;br&gt;• Hasil skrining&lt;br&gt;• Riwayat analisis&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="540" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dblist2" value="&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;• Catatan harian &amp;amp; GDP&lt;br&gt;• Hasil evaluasi program&lt;br&gt;• Notifikasi&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="540" width="190" height="70" as="geometry"/>
        </mxCell>

        <!-- Tiga proses turun lurus ke database -->
        <mxCell id="e_kl_db" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="235" y="450" as="sourcePoint"/>
            <mxPoint x="235" y="520" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_ku_db" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="450" as="sourcePoint"/>
            <mxPoint x="430" y="520" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_pr_db" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="625" y="450" as="sourcePoint"/>
            <mxPoint x="625" y="520" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
